diff --git a/css/game.css b/css/game.css
index 6313df3..0000000 100644
--- a/css/game.css
+++ b/css/game.css
@@ -854,0 +855,60 @@
+
+/* ============================================================
+   GOODBYE GOTH V9.0 - FULL-WIDTH MAP + TRANSPARENT HUD OVERLAY
+   ============================================================ */
+.game-screen .game-layout {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr);
+  gap: 0;
+  padding: 4px;
+  width: 100%;
+  flex: 1;
+  min-height: 0;
+}
+
+.game-screen .play-column {
+  width: 100%;
+  min-width: 0;
+  min-height: 0;
+}
+
+.game-screen .world-wrap {
+  width: 100%;
+  flex: 1 1 auto;
+  min-height: 0;
+  padding: 0;
+  overflow: hidden;
+}
+
+.game-screen #world {
+  display: block;
+  width: 100%;
+  height: 100%;
+  min-height: 0;
+  max-height: none;
+  aspect-ratio: auto;
+  object-fit: fill;
+}
+
+/* The sidebar is removed from the layout; Olly's HUD floats above the map. */
+.game-screen .side-column {
+  display: none !important;
+}
+
+.game-screen .player-hud {
+  background: transparent;
+  border: 0;
+  border-radius: 0;
+  box-shadow: none;
+  padding: 0;
+  pointer-events: none;
+}
+
+.game-screen .player-hud-name,
+.game-screen .player-hp-text {
+  text-shadow: 0 1px 4px rgba(0, 0, 0, .95);
+}
+
+.game-screen .player-hud button {
+  pointer-events: auto;
+}
