{
  "name": "goodbye-goth",
  "productName": "Goodbye Goth",
  "version": "0.9.56",
  "description": "Goodbye Goth - an anniversary gift for Olly",
  "main": "main.js",
  "author": "Scarlett",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "33.2.0",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.goodbyegoth.game",
    "productName": "Goodbye Goth",
    "asar": false,
    "afterPack": "afterPack.js",
    "directories": { "output": "dist" },
    "files": ["main.js", "game/**/*"],
    "mac": { "identity": null, "category": "public.app-category.games", "icon": "build/icon.png", "target": [{ "target": "dmg", "arch": ["arm64"] }] },
    "win": { "icon": "build/icon.png", "target": [{ "target": "nsis", "arch": ["x64"] }] },
    "nsis": { "oneClick": true, "perMachine": false }
  }
}
